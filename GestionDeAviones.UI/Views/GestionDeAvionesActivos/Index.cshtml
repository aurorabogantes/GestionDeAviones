@model IEnumerable<GestionDeAviones.Model.Avion>

@{
    ViewData["Title"] = "Index";
}
@if (@ViewData["ProblemasAlConsultar"] as bool? == true)
{
    <div class="alert alert-danger" role="alert">
        Problemas al listar activos
    </div>
}

<h1>Aviones Activas</h1>
<p>
    <a asp-action="Create" class="btn btn-success">Registrar</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modelo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modelo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-warning" }) |
                    @Html.ActionLink("Desactivar", "DesActivar", "GestionDeAviones", new { id = item.Id }, new { @class = "btn btn-danger" }) |

                </td>
            </tr>
        }
    </tbody>
</table>